PORT=3000

# Vul dit in met een lange, willekeurige string.
SESSION_SECRET=verander-dit-in-iets-lang-en-willekeurigs

ADMIN_USERNAME=admin

# Genereer met: npm run hash-password -- "jouwWachtwoord"
# en plak de uitkomst hieronder. Sla nooit het wachtwoord zelf op, alleen de hash.
ADMIN_PASSWORD_HASH=
